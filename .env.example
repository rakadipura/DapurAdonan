# PostgreSQL connection string
# For Vercel serverless: use PgBouncer connection pooling
# DATABASE_URL="postgresql://USER:PASSWORD@host:5432/db?pgbouncer=true&connection_limit=1"
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/toko_mini_moni?schema=public"

# Admin dashboard (/admin) — pick a strong password and a long random secret.
# Generate a secret with: openssl rand -base64 32
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="change-me-too-a-long-random-string"
