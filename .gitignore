# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log

# local patches / scratch files
*.patch

# uploaded files (payment proofs) stored by the app
/uploads/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local dev/run artifacts (worktree notes, logs) - not meant to be committed
.freebuff/

# typescript
*.tsbuildinfo
next-env.d.ts
